{
  // Editor settings
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true,
    "source.organizeImports": true
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.rulers": [120],
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 120,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.indentation": true,
  "editor.renderWhitespace": "boundary",
  "editor.trimAutoWhitespace": true,
  "editor.linkedEditing": true,
  "editor.suggest.insertMode": "replace",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "editor.parameterHints.enabled": true,
  "editor.hover.enabled": true,
  "editor.lightbulb.enabled": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.inlayHints.enabled": "on",
  "editor.stickyScroll.enabled": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,

  // Files settings
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 1000,
  "files.hotExit": "onExitAndWindowClose",
  "files.defaultLanguage": "typescript",
  "files.associations": {
    "*.vue": "vue",
    "*.ts": "typescript",
    "*.js": "javascript",
    "*.jsx": "javascriptreact",
    "*.tsx": "typescriptreact",
    "*.json": "jsonc",
    "*.md": "markdown",
    "*.scss": "scss",
    "*.css": "css",
    "*.html": "html",
    "*.yml": "yaml",
    "*.yaml": "yaml",
    ".env*": "dotenv",
    ".eslintrc*": "jsonc",
    ".prettierrc*": "jsonc",
    "tsconfig*.json": "jsonc",
    "vite.config.*": "typescript",
    "vitest.config.*": "typescript"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.log": true,
    "**/.cache": true,
    "**/.temp": true,
    "**/.tmp": true,
    "**/coverage": true,
    "**/.nyc_output": true,
    "**/.vscode/settings.json": false
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/coverage/**": true,
    "**/.cache/**": true,
    "**/.temp/**": true,
    "**/.tmp/**": true
  },

  // Search settings
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/.cache": true,
    "**/.temp": true,
    "**/.tmp": true,
    "**/*.log": true,
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "search.useGlobalIgnoreFiles": true,
  "search.useIgnoreFiles": true,
  "search.smartCase": true,
  "search.showLineNumbers": true,

  // Explorer settings
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "explorer.openEditors.visible": 10,
  "explorer.sortOrder": "type",
  "explorer.decorations.colors": true,
  "explorer.decorations.badges": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.js.map",
    "*.vue": "${capture}.vue.d.ts",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc, .yarnrc, .yarnrc.yml",
    "tsconfig.json": "tsconfig.*.json",
    "vite.config.*": "vitest.config.*, vite.config.*.timestamp-*",
    ".eslintrc.*": ".eslintignore, .eslintcache",
    ".prettierrc.*": ".prettierignore",
    "README.md": "CHANGELOG.md, LICENSE, LICENSE.md, LICENSE.txt",
    ".env": ".env.*, .envrc",
    "docker-compose.yml": "docker-compose.*.yml, Dockerfile, .dockerignore",
    "index.html": "favicon.ico, robots.txt, sitemap.xml, manifest.json"
  },

  // Workbench settings
  "workbench.colorTheme": "Default Dark+",
  "workbench.iconTheme": "vs-seti",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 10,
  "workbench.editor.limit.perEditorGroup": false,
  "workbench.startupEditor": "newUntitledFile",
  "workbench.settings.editor": "json",
  "workbench.settings.openDefaultSettings": true,
  "workbench.settings.useSplitJSON": true,
  "workbench.tree.indent": 20,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.activityBar.visible": true,
  "workbench.statusBar.visible": true,
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.panel.opensMaximized": "never",

  // Terminal settings
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontFamily": "'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Source Code Pro', Consolas, 'Courier New', monospace",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shell.windows": "pwsh.exe",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash"
    }
  },
  "terminal.integrated.env.windows": {},
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "terminal.integrated.enableBell": false,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.rightClickBehavior": "default",

  // Git settings
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.autofetchPeriod": 180,
  "git.autoStash": true,
  "git.enableCommitSigning": false,
  "git.defaultCloneDirectory": "~/Projects",
  "git.openRepositoryInParentFolders": "always",
  "git.decorations.enabled": true,
  "git.showPushSuccessNotification": true,
  "git.suggestSmartCommit": true,
  "git.timeline.showAuthor": true,
  "git.timeline.showUncommitted": true,
  "git.useCommitInputAsStashMessage": true,
  "git.verboseCommit": true,
  "git.allowForcePush": false,
  "git.alwaysShowStagedChangesResourceGroup": true,
  "git.branchProtection": ["main", "master", "develop"],
  "git.ignoreLegacyWarning": true,
  "git.ignoreRebaseWarning": true,
  "git.ignoreMissingGitWarning": true,

  // Language-specific settings
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": true,
      "source.organizeImports": true
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": true,
      "source.organizeImports": true
    }
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": true,
      "source.organizeImports": true
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[less]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
    "editor.formatOnSave": true
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker",
    "editor.formatOnSave": true
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell",
    "editor.formatOnSave": true
  },
  "[dotenv]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": false
  },

  // Extension-specific settings
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue"
  ],
  "eslint.format.enable": true,
  "eslint.codeAction.showDocumentation": {
    "enable": true
  },
  "eslint.codeActionsOnSave.mode": "all",
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "eslint.options": {
    "extensions": [".js", ".jsx", ".ts", ".tsx", ".vue"]
  },
  "eslint.probe": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue"
  ],

  "prettier.enable": true,
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": true,
  "prettier.resolveGlobalModules": true,
  "prettier.withNodeModules": false,
  "prettier.documentSelectors": [
    "**/*.{js,jsx,ts,tsx,vue,json,css,scss,less,html,md,yaml,yml}"
  ],

  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "typescript.suggest.includeCompletionsForModuleExports": true,
  "typescript.suggest.includeAutomaticOptionalChainCompletions": true,
  "typescript.preferences.includePackageJsonAutoImports": "auto",
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": false,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "typescript.workspaceSymbols.scope": "allOpenProjects",
  "typescript.preferences.quoteStyle": "single",
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.suggest.completeFunctionCalls": true,
  "typescript.suggest.jsdoc.generateReturns": true,
  "typescript.format.enable": false,
  "typescript.validate.enable": true,
  "typescript.surveys.enabled": false,

  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.suggest.autoImports": true,
  "javascript.suggest.includeCompletionsForModuleExports": true,
  "javascript.suggest.includeAutomaticOptionalChainCompletions": true,
  "javascript.preferences.includePackageJsonAutoImports": "auto",
  "javascript.inlayHints.parameterNames.enabled": "literals",
  "javascript.inlayHints.parameterTypes.enabled": true,
  "javascript.inlayHints.variableTypes.enabled": false,
  "javascript.inlayHints.propertyDeclarationTypes.enabled": true,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
  "javascript.inlayHints.enumMemberValues.enabled": true,
  "javascript.preferences.quoteStyle": "single",
  "javascript.preferences.importModuleSpecifier": "relative",
  "javascript.suggest.completeFunctionCalls": true,
  "javascript.suggest.jsdoc.generateReturns": true,
  "javascript.format.enable": false,
  "javascript.validate.enable": true,

  "vetur.validation.template": false,
  "vetur.validation.script": false,
  "vetur.validation.style": false,
  "vetur.format.enable": false,
  "vetur.useWorkspaceDependencies": true,
  "vetur.experimental.templateInterpolationService": true,

  "volar.takeOverMode.enabled": true,
  "volar.codeLens.pugTools": false,
  "volar.codeLens.scriptSetupTools": true,
  "volar.completion.preferredTagNameCase": "pascal",
  "volar.completion.preferredAttrNameCase": "kebab",
  "volar.preview.port": 3333,
  "volar.preview.backgroundColor": "#ffffff",

  "emmet.includeLanguages": {
    "vue-html": "html",
    "vue": "html",
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  "emmet.triggerExpansionOnTab": true,
  "emmet.showExpandedAbbreviation": "always",
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.variables": {
    "lang": "zh-CN",
    "charset": "UTF-8"
  },

  "html.format.enable": false,
  "html.suggest.html5": true,
  "html.autoClosingTags": true,
  "html.completion.attributeDefaultValue": "doublequotes",
  "html.format.wrapAttributes": "auto",
  "html.format.wrapLineLength": 120,
  "html.format.indentInnerHtml": true,
  "html.format.preserveNewLines": true,
  "html.format.maxPreserveNewLines": 2,

  "css.validate": true,
  "css.lint.duplicateProperties": "warning",
  "css.lint.emptyRules": "warning",
  "css.lint.importStatement": "warning",
  "css.lint.boxModel": "warning",
  "css.lint.universalSelector": "warning",
  "css.lint.zeroUnits": "warning",
  "css.lint.fontFaceProperties": "warning",
  "css.lint.hexColorLength": "warning",
  "css.lint.argumentsInColorFunction": "warning",
  "css.lint.unknownProperties": "warning",
  "css.lint.validProperties": [],
  "css.completion.triggerPropertyValueCompletion": true,
  "css.completion.completePropertyWithSemicolon": true,
  "css.hover.documentation": true,
  "css.hover.references": true,

  "scss.validate": true,
  "scss.lint.duplicateProperties": "warning",
  "scss.lint.emptyRules": "warning",
  "scss.lint.importStatement": "warning",
  "scss.lint.boxModel": "warning",
  "scss.lint.universalSelector": "warning",
  "scss.lint.zeroUnits": "warning",
  "scss.lint.fontFaceProperties": "warning",
  "scss.lint.hexColorLength": "warning",
  "scss.lint.argumentsInColorFunction": "warning",
  "scss.lint.unknownProperties": "warning",
  "scss.lint.validProperties": [],
  "scss.completion.triggerPropertyValueCompletion": true,
  "scss.completion.completePropertyWithSemicolon": true,
  "scss.hover.documentation": true,
  "scss.hover.references": true,

  "less.validate": true,
  "less.lint.duplicateProperties": "warning",
  "less.lint.emptyRules": "warning",
  "less.lint.importStatement": "warning",
  "less.lint.boxModel": "warning",
  "less.lint.universalSelector": "warning",
  "less.lint.zeroUnits": "warning",
  "less.lint.fontFaceProperties": "warning",
  "less.lint.hexColorLength": "warning",
  "less.lint.argumentsInColorFunction": "warning",
  "less.lint.unknownProperties": "warning",
  "less.lint.validProperties": [],
  "less.completion.triggerPropertyValueCompletion": true,
  "less.completion.completePropertyWithSemicolon": true,
  "less.hover.documentation": true,
  "less.hover.references": true,

  "json.validate.enable": true,
  "json.format.enable": false,
  "json.schemas": [],
  "json.trace.server": "off",

  "yaml.validate": true,
  "yaml.format.enable": false,
  "yaml.hover": true,
  "yaml.completion": true,
  "yaml.schemas": {},
  "yaml.schemaStore.enable": true,
  "yaml.customTags": [],
  "yaml.maxItemsComputed": 5000,

  "markdown.preview.fontSize": 14,
  "markdown.preview.lineHeight": 1.6,
  "markdown.preview.fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
  "markdown.preview.breaks": false,
  "markdown.preview.linkify": true,
  "markdown.preview.typographer": true,
  "markdown.preview.scrollPreviewWithEditor": true,
  "markdown.preview.markEditorSelection": true,
  "markdown.preview.scrollEditorWithPreview": true,
  "markdown.preview.doubleClickToSwitchToEditor": true,
  "markdown.extension.toc.levels": "1..6",
  "markdown.extension.toc.orderedList": false,
  "markdown.extension.toc.plaintext": false,
  "markdown.extension.toc.updateOnSave": true,
  "markdown.extension.preview.autoShowPreviewToSide": false,
  "markdown.extension.orderedList.marker": "ordered",
  "markdown.extension.orderedList.autoRenumber": true,
  "markdown.extension.list.indentationSize": "adaptive",
  "markdown.extension.italic.indicator": "*",
  "markdown.extension.bold.indicator": "**",
  "markdown.extension.completion.root": "",
  "markdown.extension.tableFormatter.enabled": true,
  "markdown.extension.tableFormatter.normalizeIndentation": true,
  "markdown.extension.math.enabled": true,

  // Performance settings
  "extensions.autoUpdate": true,
  "extensions.autoCheckUpdates": true,
  "extensions.ignoreRecommendations": false,
  "extensions.showRecommendationsOnlyOnDemand": false,
  "update.mode": "start",
  "update.enableWindowsBackgroundUpdates": true,
  "telemetry.telemetryLevel": "error",
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.banner": "never",
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.emptyWindow": false,

  // Debug settings
  "debug.allowBreakpointsEverywhere": true,
  "debug.inlineValues": "auto",
  "debug.showInStatusBar": "always",
  "debug.toolBarLocation": "floating",
  "debug.console.fontSize": 14,
  "debug.console.fontFamily": "default",
  "debug.console.lineHeight": 0,
  "debug.console.wordWrap": true,
  "debug.console.historySuggestions": true,
  "debug.console.acceptSuggestionOnEnter": "on",
  "debug.openDebug": "openOnDebugBreak",
  "debug.openExplorerOnEnd": false,
  "debug.focusWindowOnBreak": true,
  "debug.focusEditorOnBreak": true,
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.showInlineBreakpointCandidates": true,
  "debug.saveBeforeStart": "allEditorsInActiveGroup",
  "debug.onTaskErrors": "prompt",
  "debug.terminal.clearBeforeReusing": false,

  // Task settings
  "task.autoDetect": "on",
  "task.problemMatchers.neverPrompt": false,
  "task.quickOpen.history": 30,
  "task.quickOpen.detail": true,
  "task.quickOpen.skip": false,
  "task.saveBeforeRun": "always",
  "task.showDecorations": true,
  "task.slowProviderWarning": true,

  // Problems settings
  "problems.autoReveal": true,
  "problems.decorations.enabled": true,
  "problems.defaultViewMode": "tree",
  "problems.showCurrentInStatus": true,
  "problems.sortOrder": "severity",

  // Breadcrumbs settings
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",
  "breadcrumbs.symbolSortOrder": "position",
  "breadcrumbs.icons": true,
  "breadcrumbs.showFiles": true,
  "breadcrumbs.showSymbols": true,
  "breadcrumbs.showKeys": true,
  "breadcrumbs.showNumbers": true,
  "breadcrumbs.showBooleans": true,
  "breadcrumbs.showArrays": true,
  "breadcrumbs.showObjects": true,
  "breadcrumbs.showClasses": true,
  "breadcrumbs.showMethods": true,
  "breadcrumbs.showProperties": true,
  "breadcrumbs.showFields": true,
  "breadcrumbs.showConstructors": true,
  "breadcrumbs.showEnums": true,
  "breadcrumbs.showInterfaces": true,
  "breadcrumbs.showFunctions": true,
  "breadcrumbs.showVariables": true,
  "breadcrumbs.showConstants": true,
  "breadcrumbs.showStrings": true,
  "breadcrumbs.showNamespaces": true,
  "breadcrumbs.showPackages": true,
  "breadcrumbs.showModules": true,

  // Outline settings
  "outline.icons": true,
  "outline.problems.enabled": true,
  "outline.problems.badges": true,
  "outline.problems.colors": true,
  "outline.showFiles": true,
  "outline.showSymbols": true,
  "outline.showKeys": true,
  "outline.showNumbers": true,
  "outline.showBooleans": true,
  "outline.showArrays": true,
  "outline.showObjects": true,
  "outline.showClasses": true,
  "outline.showMethods": true,
  "outline.showProperties": true,
  "outline.showFields": true,
  "outline.showConstructors": true,
  "outline.showEnums": true,
  "outline.showInterfaces": true,
  "outline.showFunctions": true,
  "outline.showVariables": true,
  "outline.showConstants": true,
  "outline.showStrings": true,
  "outline.showNamespaces": true,
  "outline.showPackages": true,
  "outline.showModules": true,

  // Zen mode settings
  "zenMode.centerLayout": true,
  "zenMode.fullScreen": true,
  "zenMode.hideActivityBar": true,
  "zenMode.hideLineNumbers": false,
  "zenMode.hideStatusBar": true,
  "zenMode.hideTabs": true,
  "zenMode.restore": true,
  "zenMode.silentNotifications": true,

  // Accessibility settings
  "accessibility.signals.lineHasBreakpoint": {
    "sound": "auto"
  },
  "accessibility.signals.lineHasError": {
    "sound": "auto"
  },
  "accessibility.signals.lineHasFoldedArea": {
    "sound": "auto"
  },
  "accessibility.signals.lineHasInlineSuggestion": {
    "sound": "auto"
  },
  "accessibility.signals.onDebugBreak": {
    "sound": "auto"
  },
  "accessibility.signals.noInlayHints": {
    "sound": "auto"
  },
  "accessibility.signals.taskCompleted": {
    "sound": "auto"
  },
  "accessibility.signals.taskFailed": {
    "sound": "auto"
  },
  "accessibility.signals.terminalCommandFailed": {
    "sound": "auto"
  },
  "accessibility.signals.terminalQuickFix": {
    "sound": "auto"
  },
  "accessibility.verbosity.terminal": false,
  "accessibility.verbosity.diff-editor": false,
  "accessibility.verbosity.editor": false,
